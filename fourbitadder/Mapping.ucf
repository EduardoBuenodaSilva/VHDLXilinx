#BOARD CLOCK
NET "CLK" LOC = "T8" | TNM_NET = sys_clk_pin;
TIMESPEC TS_sys_clk_pin = PERIOD sys_clk_pin 50000 kHz;

#USER LEDs
NET "LED<0>" LOC = "P4" | IOSTANDARD = LVCMOS33;
NET "LED<1>" LOC = "N5" | IOSTANDARD = LVCMOS33;
NET "LED<2>" LOC = "P5" | IOSTANDARD = LVCMOS33;
NET "LED<3>" LOC = "M6" | IOSTANDARD = LVCMOS33;

#USER PUSHBUTTONS

NET "KEY1" LOC = "E3" | IOSTANDARD = LVCMOS33;
NET "KEY2" LOC = "E4" | IOSTANDARD = LVCMOS33;
NET "KEY3" LOC = "D3" | IOSTANDARD = LVCMOS33;
NET "KEY4" LOC = "C3" | IOSTANDARD = LVCMOS33;